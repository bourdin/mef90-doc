mma   if -\\gamma/2 < x \\le \\gamma/2\n     x&#94;2+gamma&#94;2/12            otherwise Arguments Type Intent Optional Attributes Name real(kind=C_DOUBLE), intent(in) :: x real(kind=C_DOUBLE), intent(in) :: gamma Return Value real(kind=C_DOUBLE)","tags":"","url":"proc/mef90defmechsplit_smoothpositivesquare.html"},{"title":"MEF90HookesLawZero_View – mef90 / vDef","text":"private  subroutine MEF90HookesLawZero_View(self, viewer, ierr) MEF90HookesLawZero_view: the default viewer for a MEF90_DefMechAT_Type Type Bound MEF90HookesLawZero Arguments Type Intent Optional Attributes Name class( MEF90HookesLawZero ), intent(in) :: self type(tPetscViewer), intent(in) :: viewer integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90hookeslawzero_view.html"},{"title":"MEF90HookesLawZero_mult – mef90 / vDef","text":"private  subroutine MEF90HookesLawZero_mult(A, phi, Aphi, ierr) Type Bound MEF90HookesLawZero Arguments Type Intent Optional Attributes Name class( MEF90HookesLawZero ), intent(in) :: A class( mef90Mat ), intent(in) :: phi class( mef90Mat ), intent(out), allocatable :: Aphi integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90hookeslawzero_mult.html"},{"title":"MEF90HookesLawZero_multmult – mef90 / vDef","text":"private  subroutine MEF90HookesLawZero_multmult(A, phi, psi, Aphipsi, ierr) Type Bound MEF90HookesLawZero Arguments Type Intent Optional Attributes Name class( MEF90HookesLawZero ), intent(in) :: A class( mef90Mat ), intent(in) :: phi class( mef90Mat ), intent(in) :: psi real(kind=C_DOUBLE), intent(out) :: Aphipsi integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90hookeslawzero_multmult.html"},{"title":"MEF90HookesLawZero_setFromOptions – mef90 / vDef","text":"private  subroutine MEF90HookesLawZero_setFromOptions(self, ierr) MEF90HookesLawZero_setFromOptions: initializes a MEF90HookesLawZero from options Type Bound MEF90HookesLawZero Arguments Type Intent Optional Attributes Name class( MEF90Hoo