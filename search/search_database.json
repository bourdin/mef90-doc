 it is expected that these will call MEF90DefMechAT_setFromOptions Type Bound MEF90DefMechAT_Type Arguments Type Intent Optional Attributes Name class( MEF90DefMechAT_Type ), intent(inout) :: self integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90defmechat_setfromoptions.html"},{"title":"D2EEDNone – mef90 / vDef","text":"private  subroutine D2EEDNone(self, HookesLaw, phi, psi, D2EEDPlus, D2EEDMinus, ierr) D2EEDNone: Compute the second derivative of the positive and negative part of the elastic energy density (positive and negative stress)\n             evaluated at the strain tensor Strain.\n             without a split, D2EEDPlus = HookesLaw, D2EEDMinus = 0 Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(in) :: self class( MEF90HookesLaw ), intent(in) :: HookesLaw class( mef90Mat ), intent(in) :: phi class( mef90Mat ), intent(in) :: psi real(kind=C_DOUBLE), intent(out) :: D2EEDPlus real(kind=C_DOUBLE), intent(out) :: D2EEDMinus integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/d2eednone.html"},{"title":"DEEDNone – mef90 / vDef","text":"private  subroutine DEEDNone(self, HookesLaw, phi, DEEDPlus, DEEDMinus, ierr) DEEDNone: Compute the derivative of the positive and negative part of the elastic energy density (positive and negative stress)\n             evaluated at the strain tensor Strain.\n         without a split, we have DEEDPlus  = HookesLaw Strain\n                                  DEEDMinus = 0 Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(in) :: self class( MEF90HookesLaw ), intent(in) :: HookesLaw class( mef90Mat ), intent(in) :: phi real(kind=C_DOUBLE), intent(out) :: DEEDPlus real(kind=C_DOUBLE), intent(out) :: DEEDMinus integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/deednone.html"},{"title":"EEDNone – mef90 / vDef","text":"private  subroutine EEDNone(self, HookesLaw, phi, EEDPlus, EEDMinus, ierr) EEDNone: Compute the positive and negative part of the elastic energy density associated with a strain tensor\n         without a split, we have EEDPlus  = 1/2 HookesLaw Strain \\cdot Strain\n                                  EEDMinus = 0 Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(in) :: self class( MEF90HookesLaw ), intent(in) :: HookesLaw class( mef90Mat ), intent(in) :: phi real(kind=C_DOUBLE), intent(out) :: EEDPlus real(kind=C_DOUBLE), intent(out) :: EEDMinus integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/eednone.html"},{"title":"MEF90DefMechSplitNone_setFromOptions – mef90 / vDef","text":"private  subroutine MEF90DefMechSplitNone_setFromOptions(self, ierr) MEF90DefMechSplitNone_setFromOptions: the default constructor for a MEF90DefMechSplitNone Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(inout) :: self integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90defmechsplitnone_setfromoptions.html"},{"title":"MEF90DefMechSplitNone_view – mef90 / vDef","text":"private  subroutine MEF90DefMechSplitNone_view(self, viewer, ierr) MEF90DefMechSplitNone_view: view a MEF90DefMechSplitNone Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(in) :: self type(tPetscViewer), intent(in) :: viewer integer(kind=C_INT32_T), intent(inout) :: ierr","tags":"","url":"proc/mef90defmechsplitnone_view.html"},{"title":"setupNONE – mef90 / vDef","text":"private  subroutine setupNONE(self, Strain, ierr) Uses m_MEF90 setupNONE: the setup routine for a MEF90DefMechSplitNone, which does nothing since there is no split Type Bound MEF90DefMechSplitNone Arguments Type Intent Optional Attributes Name class( MEF90DefMechSplitNone ), intent(inout) :: self class( mef90Mat ), intent(in) :: Stra